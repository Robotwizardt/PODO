<Window x:Class="WitchDrawer.App.Views.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="PODO"
        Width="420"
        SizeToContent="WidthAndHeight"
        MinWidth="360"
        MaxWidth="560"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle"
               BasedOn="{StaticResource GhostButtonStyle}"
               TargetType="Button">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
        </Style>
        <Style x:Key="DialogPrimaryButtonStyle"
               BasedOn="{StaticResource PrimaryButtonStyle}"
               TargetType="Button">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
        </Style>
        <Style x:Key="DialogDangerButtonStyle"
               BasedOn="{StaticResource DangerButtonStyle}"
               TargetType="Button">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ControlCenterSurfaceBrush}"
            BorderBrush="{DynamicResource GlassStrokeBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource WindowCornerRadius}"
            Padding="20,18,20,18"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              Direction="270"
                              Opacity="0.24"
                              ShadowDepth="4" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="30"
                        Height="30"
                        CornerRadius="15"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource GlassControlBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IconKind}" Value="Warning">
                                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IconKind}" Value="Question">
                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IconKind}" Value="Error">
                                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Glyph}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IconKind}" Value="Warning">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconKind}" Value="Error">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconKind}" Value="Question">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <TextBlock Grid.Column="1"
                           Text="{Binding Title}"
                           FontFamily="{DynamicResource AppDisplayFontFamily}"
                           FontSize="{DynamicResource SectionFontSize}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="{Binding Message}"
                       FontSize="{DynamicResource BodyFontSize}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Margin="0,0,0,18" />

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="AffirmativeButton"
                        Style="{DynamicResource DialogPrimaryButtonStyle}"
                        Click="OnAffirmativeClick"
                        IsDefault="True" />
                <Button x:Name="NegativeButton"
                        Style="{DynamicResource DialogButtonStyle}"
                        Click="OnNegativeClick"
                        IsCancel="True"
                        Visibility="Collapsed" />
                <Button x:Name="CancelButton"
                        Style="{DynamicResource DialogButtonStyle}"
                        Click="OnCancelClick"
                        Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
