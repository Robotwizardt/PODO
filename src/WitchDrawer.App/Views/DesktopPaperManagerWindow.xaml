<Window x:Class="WitchDrawer.App.Views.DesktopPaperManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面便签管理"
        Icon="pack://application:,,,/PODO;component/Assets/app.png"
        Width="660"
        Height="470"
        MinWidth="520"
        MinHeight="340"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="Transparent"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border Margin="12"
            Background="{DynamicResource AcrylicSurfaceBrush}"
            BorderBrush="{DynamicResource AcrylicStrokeBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource WindowCornerRadius}"
            ClipToBounds="True"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              Direction="270"
                              Opacity="0.14"
                              ShadowDepth="3" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="3"
                    Margin="1"
                    BorderBrush="{DynamicResource GlassHighlightBrush}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="16"
                    IsHitTestVisible="False"
                    Opacity="0.66" />

            <Border Padding="18,15,10,13"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="16"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="桌面便签管理"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="已隐藏的便签可在这里恢复；所有便签都可归档或永久删除"
                                   Margin="0,5,0,0"
                                   FontSize="{DynamicResource CaptionFontSize}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="30"
                            Height="30"
                            Padding="0"
                            Style="{StaticResource GhostButtonStyle}"
                            ToolTip="关闭"
                            AutomationProperties.Name="关闭桌面便签管理"
                            Click="OnCloseClicked">
                        <TextBlock Text="&#xE8BB;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="13" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="18,11,18,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource AccentSoftBrush}"
                        CornerRadius="6"
                        Padding="8,4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="已隐藏"
                                    FontSize="{DynamicResource CaptionFontSize}"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding HiddenPaperCount}"
                                   Margin="6,0,0,0"
                                    FontSize="{DynamicResource CaptionFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                </Border>
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusText}"
                           Margin="10,0"
                            FontSize="{DynamicResource CaptionFontSize}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2"
                        Width="30"
                        Height="28"
                        Padding="0"
                        Style="{StaticResource GhostButtonStyle}"
                        ToolTip="刷新列表"
                        AutomationProperties.Name="刷新桌面便签列表"
                        Click="OnRefreshClicked">
                    <TextBlock Text="&#xE72C;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="13" />
                </Button>
                <Button Grid.Column="3"
                        Height="28"
                        Margin="7,0,0,0"
                        Padding="10,4"
                        Style="{StaticResource DangerButtonStyle}"
                        ToolTip="永久删除所有已隐藏的便签"
                        Click="OnDeleteHiddenPapersClicked">
                    <TextBlock Text="清空已隐藏"
                                FontSize="{DynamicResource CaptionFontSize}" />
                </Button>
            </Grid>

            <Grid Grid.Row="2"
                  Margin="12,0,12,12">
                <ListBox ItemsSource="{Binding Papers}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         FocusVisualStyle="{DynamicResource AppFocusVisualStyle}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,5" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Border x:Name="Root"
                                                Background="{DynamicResource PanelAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,8">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
                                                <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="26"
                                        Height="26"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        CornerRadius="6"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8A5;"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="12"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="2,0,10,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,3,0,0"
                                                FontSize="{DynamicResource CaptionFontSize}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding KindLabel}" />
                                        <Run Text="  ·  " />
                                        <Run Text="{Binding DetailLabel}" />
                                    </TextBlock>
                                </StackPanel>
                                <Border Grid.Column="2"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        CornerRadius="5"
                                        Padding="6,3"
                                        VerticalAlignment="Center"
                                        Margin="0,0,7,0">
                                    <TextBlock Text="{Binding VisibilityLabel}"
                                                FontSize="{DynamicResource CaptionFontSize}"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <Button Grid.Column="3"
                                        Height="27"
                                        Padding="9,3"
                                        Margin="0,0,4,0"
                                        Style="{StaticResource GhostButtonStyle}"
                                        IsEnabled="{Binding IsHidden}"
                                        ToolTip="恢复到桌面"
                                        Tag="{Binding}"
                                        Click="OnShowPaperClicked">
                                    <TextBlock Text="显示"
                                                FontSize="{DynamicResource CaptionFontSize}" />
                                </Button>
                                <Button Grid.Column="4"
                                        Height="27"
                                        Padding="9,3"
                                        Margin="0,0,4,0"
                                        Style="{StaticResource GhostButtonStyle}"
                                        ToolTip="归档到归档区"
                                        Tag="{Binding}"
                                        Click="OnArchivePaperClicked">
                                    <TextBlock Text="归档"
                                                FontSize="{DynamicResource CaptionFontSize}" />
                                </Button>
                                <Button Grid.Column="5"
                                        Width="28"
                                        Height="27"
                                        Padding="0"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Foreground="{DynamicResource DangerBrush}"
                                        ToolTip="永久删除"
                                        AutomationProperties.Name="永久删除便签"
                                        Tag="{Binding}"
                                        Click="OnDeletePaperClicked">
                                    <TextBlock Text="&#xE74D;"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="13" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Background="{DynamicResource PanelAltBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding HasPapers, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                        IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="&#xE8A5;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="22"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="没有桌面便签"
                                   Margin="0,8,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
