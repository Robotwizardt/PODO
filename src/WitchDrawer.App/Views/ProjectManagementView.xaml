<UserControl x:Class="WitchDrawer.App.Views.ProjectManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infrastructure="clr-namespace:WitchDrawer.App.Infrastructure"
             MinHeight="260"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="项目收纳盒"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="{DynamicResource CaptionFontSize}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding ProjectName}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontFamily="{DynamicResource AppDisplayFontFamily}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="RenameProjectButton"
                        Click="OnRenameProjectClicked"
                        Width="28"
                        Height="28"
                         Padding="0"
                         Style="{StaticResource GhostButtonStyle}"
                         ToolTip="重命名项目收纳盒"
                         AutomationProperties.Name="重命名项目收纳盒">
                    <TextBlock Text="&#xE70F;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="13" />
                </Button>
                <Button Command="{Binding DataContext.ToggleSelectedBoxPositionLockCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Margin="3,0,0,0"
                         Style="{StaticResource GhostButtonStyle}"
                         ToolTip="{Binding DataContext.SelectedBox.PositionLockButtonToolTip, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                         AutomationProperties.Name="切换项目收纳盒位置锁定">
                    <TextBlock Text="&#xE72E;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="13" />
                </Button>
                <Grid Margin="3,0,0,0">
                    <Button x:Name="ProjectMoreBoxActionsButton"
                            Click="OnOpenProjectBoxActionsMenu"
                            Width="28"
                            Height="28"
                             Padding="0"
                             Style="{StaticResource GhostButtonStyle}"
                             ToolTip="更多项目收纳盒操作"
                             AutomationProperties.Name="更多项目收纳盒操作">
                        <TextBlock Text="&#xE712;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="14" />
                    </Button>
                    <Popup x:Name="ProjectBoxActionsPopup"
                           PlacementTarget="{Binding ElementName=ProjectMoreBoxActionsButton}"
                           Placement="Bottom"
                           VerticalOffset="5"
                           HorizontalOffset="-116"
                           DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                           AllowsTransparency="True"
                           StaysOpen="True"
                           PopupAnimation="{x:Static infrastructure:WindowMotion.PopupAnimation}">
                        <Border Margin="8"
                                Padding="5"
                                MinWidth="178"
                                 Background="{DynamicResource AcrylicSurfaceBrush}"
                                 BorderBrush="{DynamicResource AcrylicStrokeBrush}"
                                BorderThickness="1"
                                 CornerRadius="{DynamicResource PopupCornerRadius}">
                            <StackPanel>
                                <Button Click="OnShowProjectDesktopBoxClicked"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="9,7"
                                        HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE890;"
                                                   Width="20"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="显示桌面项目收纳盒"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ToggleSelectedBoxPositionLockCommand}"
                                        Click="OnProjectBoxActionMenuItemClicked"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="9,7"
                                        HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72E;"
                                                   Width="20"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedBox.PositionLockButtonToolTip}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="12" />
                                    </StackPanel>
                                </Button>
                                 <Button Command="{Binding SelectedBox.ToggleTitleVisibilityCommand}"
                                        Click="OnProjectBoxActionMenuItemClicked"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="9,7"
                                        HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE890;"
                                                   Width="20"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedBox.TitleVisibilityAutomationName}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="12" />
                                    </StackPanel>
                                 </Button>
                                 <Button Click="OnArchiveProjectBoxClicked"
                                         Style="{StaticResource GhostButtonStyle}"
                                         Padding="9,7"
                                         HorizontalContentAlignment="Left">
                                     <StackPanel Orientation="Horizontal">
                                         <TextBlock Text="&#xE7B8;"
                                                    Width="20"
                                                    FontFamily="Segoe Fluent Icons"
                                                    FontSize="13"
                                                    Foreground="{DynamicResource TextMutedBrush}" />
                                         <TextBlock Text="归档项目"
                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                    FontSize="12" />
                                     </StackPanel>
                                 </Button>
                                 <Border Height="1"
                                        Margin="4,4"
                                        Background="{DynamicResource BorderBrushSoft}" />
                                <Button Click="OnDeleteProjectBoxClicked"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="9,7"
                                        HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;"
                                                   Width="20"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource DangerBrush}" />
                                        <TextBlock Text="删除项目收纳盒"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                 Background="{DynamicResource GlassSurfaceBrush}"
                 BorderBrush="{DynamicResource GlassStrokeBrush}"
                BorderThickness="1"
                 CornerRadius="{DynamicResource SurfaceCornerRadius}"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="132" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="阶段"
                           Foreground="{DynamicResource TextMutedBrush}"
                            FontSize="{DynamicResource CaptionFontSize}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding StageOptions}"
                          Style="{StaticResource ProjectCompactComboBoxStyle}"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding SelectedStage, Mode=TwoWay}"
                          SelectionChanged="OnStageSelectionChanged"
                          Height="28"
                           ToolTip="项目阶段"
                           AutomationProperties.Name="项目阶段" />
                <TextBlock Grid.Column="2"
                           Text="{Binding ModuleCount, StringFormat=共 {0} 个模块}"
                           Foreground="{DynamicResource TextMutedBrush}"
                            FontSize="{DynamicResource CaptionFontSize}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                 Background="{DynamicResource GlassSurfaceBrush}"
                 BorderBrush="{DynamicResource GlassStrokeBrush}"
                BorderThickness="1"
                 CornerRadius="{DynamicResource SurfaceCornerRadius}"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="项目尺寸"
                           Foreground="{DynamicResource TextMutedBrush}"
                            FontSize="{DynamicResource CaptionFontSize}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <TextBlock Grid.Column="1"
                           Text="默认随内容自适应；在桌面窗口直接拖动边缘即可调整大小。"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="{DynamicResource CaptionFontSize}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Background="{DynamicResource GlassSurfaceBrush}"
                BorderBrush="{DynamicResource GlassStrokeBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource SurfaceCornerRadius}"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="模块清单"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                    FontSize="{DynamicResource CaptionFontSize}"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding ToggleModulesCommand}"
                            Width="28"
                            Height="28"
                            Padding="0"
                             Style="{StaticResource GhostButtonStyle}"
                             ToolTip="{Binding ModuleToggleToolTip}"
                             AutomationProperties.Name="{Binding ModuleToggleToolTip}">
                        <TextBlock Text="{Binding ModuleToggleGlyph}"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="13" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,10,0,8"
                      Visibility="{Binding AreModulesExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewProjectModuleTitleTextBox"
                             Text="{Binding NewModuleTitle, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnNewModuleTitleKeyDown"
                             Height="30"
                             Padding="9,0"
                             VerticalContentAlignment="Center"
                             ToolTip="模块名称" />
                    <Button Grid.Column="1"
                            Command="{Binding AddModuleCommand}"
                            Width="30"
                            Height="30"
                            Margin="6,0,0,0"
                             Padding="0"
                             Style="{StaticResource GhostButtonStyle}"
                             ToolTip="添加模块"
                             AutomationProperties.Name="添加模块">
                        <TextBlock Text="&#xE710;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="14"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Button>
                </Grid>

                <Grid Grid.Row="2"
                      Visibility="{Binding AreModulesExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="暂无模块"
                               Foreground="{DynamicResource TextMutedBrush}"
                                FontSize="{DynamicResource CaptionFontSize}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Visibility="{Binding Modules.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
                         <ListBox ItemsSource="{Binding Modules}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             Visibility="{Binding Modules.Count, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              AutomationProperties.Name="项目模块列表">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PanelAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,6">
                                    <Grid>
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="*" />
                                             <ColumnDefinition Width="104" />
                                             <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,8,0" />
                                         <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding DataContext.ModuleStateOptions, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                  Style="{StaticResource ProjectCompactComboBoxStyle}"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding ModuleState, Mode=TwoWay}"
                                                  SelectionChanged="OnIssueStateSelectionChanged"
                                                   Height="26"
                                                   ToolTip="模块状态：未开发 / 开发完成 / 上线完成" />
                                         <Button Grid.Column="2"
                                                 Width="26"
                                                 Height="26"
                                                 Margin="6,0,0,0"
                                                 Padding="0"
                                                 Command="{Binding DataContext.DeleteModuleCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                 CommandParameter="{Binding}"
                                                 Style="{StaticResource GhostButtonStyle}"
                                                 ToolTip="删除模块"
                                                 AutomationProperties.Name="删除模块">
                                             <TextBlock Text="&#xE74D;"
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource DangerBrush}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                         </Button>
                                     </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>

        <Popup x:Name="ProjectRenamePopup"
               PlacementTarget="{Binding ElementName=RenameProjectButton}"
               Placement="Bottom"
               VerticalOffset="5"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="{x:Static infrastructure:WindowMotion.PopupAnimation}">
            <Border Margin="8"
                    Width="260"
                    Padding="10"
                    Background="{DynamicResource AcrylicSurfaceBrush}"
                    BorderBrush="{DynamicResource AcrylicStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource PopupCornerRadius}">
                <StackPanel>
                    <TextBox x:Name="ProjectRenameTextBox"
                             KeyDown="OnProjectRenameKeyDown"
                             Height="30"
                             Padding="8,0"
                             VerticalContentAlignment="Center" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,8,0,0">
                        <Button Content="取消"
                                Click="OnCancelProjectRenameClicked"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="9,5" />
                        <Button Content="确认"
                                Click="OnConfirmProjectRenameClicked"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="11,5"
                                Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="ProjectDeleteConfirmPopup"
               PlacementTarget="{Binding ElementName=ProjectMoreBoxActionsButton}"
               Placement="Bottom"
               VerticalOffset="5"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="{x:Static infrastructure:WindowMotion.PopupAnimation}">
            <Border Margin="8"
                    Width="250"
                    Padding="11"
                    Background="{DynamicResource AcrylicSurfaceBrush}"
                    BorderBrush="{DynamicResource AcrylicStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource PopupCornerRadius}">
                <StackPanel>
                    <TextBlock Text="删除项目收纳盒？"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock Text="模块与关联会一并移除。"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="{DynamicResource CaptionFontSize}"
                               Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0">
                        <Button Content="取消"
                                Click="OnCancelProjectDeleteClicked"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="9,5" />
                        <Button Content="删除"
                                Click="OnConfirmProjectDeleteClicked"
                                Style="{StaticResource GhostButtonStyle}"
                                Foreground="{DynamicResource DangerBrush}"
                                Padding="11,5"
                                Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="ProjectArchiveConfirmPopup"
               PlacementTarget="{Binding ElementName=ProjectMoreBoxActionsButton}"
               Placement="Bottom"
               VerticalOffset="5"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="{x:Static infrastructure:WindowMotion.PopupAnimation}">
            <Border Margin="8"
                    Width="260"
                    Padding="11"
                    Background="{DynamicResource AcrylicSurfaceBrush}"
                    BorderBrush="{DynamicResource AcrylicStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource PopupCornerRadius}">
                <StackPanel>
                    <TextBlock Text="归档项目收纳盒？"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock Text="关联的文件收纳盒和桌面便签会一起移到归档区，并从桌面隐藏。"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="{DynamicResource CaptionFontSize}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0">
                        <Button Content="取消"
                                Click="OnCancelProjectArchiveClicked"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="9,5" />
                        <Button Content="归档"
                                Click="OnConfirmProjectArchiveClicked"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="11,5"
                                Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
