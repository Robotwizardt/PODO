<Window x:Class="WitchDrawer.App.Views.WeeklyPlanAddWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="安排待办" Width="510" SizeToContent="Height" MinHeight="360" MaxHeight="760" WindowStartupLocation="CenterOwner"
 WindowStyle="None" ShowInTaskbar="False" ResizeMode="NoResize" Background="{DynamicResource AcrylicSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource AppFontFamily}" FontSize="13">
 <Border Background="{DynamicResource AcrylicSurfaceBrush}" BorderBrush="{DynamicResource AcrylicStrokeBrush}" BorderThickness="1" CornerRadius="{DynamicResource WindowCornerRadius}">
 <DockPanel>
  <Border DockPanel.Dock="Top" Padding="18,10,10,10" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1" MouseLeftButtonDown="DragHeader">
   <DockPanel><Button DockPanel.Dock="Right" Style="{DynamicResource GhostButtonStyle}" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" Width="30" Height="30" Padding="0" Click="CloseClick" ToolTip="关闭"/><TextBlock Text="周计划" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
  </Border>
 <ScrollViewer VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource TextPrimaryBrush}"><StackPanel Margin="24">
  <TextBlock x:Name="Heading" Text="添加到周计划" FontSize="22" FontWeight="SemiBold"/>
  <TextBlock Text="每天上午、下午各最多安排 3 项" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,18"/>
  <StackPanel x:Name="ModePanel" Orientation="Horizontal" Margin="0,0,0,14">
   <RadioButton Style="{DynamicResource AppSegmentRadioStyle}" x:Name="ExistingMode" Content="从现有待办选择" IsChecked="True" Checked="ModeChanged" Margin="0,0,8,0"/>
   <RadioButton Style="{DynamicResource AppSegmentRadioStyle}" x:Name="NewMode" Content="新建待办并排期" Checked="ModeChanged"/>
  </StackPanel>
  <StackPanel x:Name="ExistingPanel">
   <TextBlock Text="未归档、未完成、尚未排期的待办" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
   <ComboBox Style="{DynamicResource AppComboBoxStyle}" x:Name="Source" SelectionChanged="SourceChanged" MaxDropDownHeight="280"
             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
    <ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel>
    <ComboBox.ItemTemplate><DataTemplate><StackPanel Margin="3">
     <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="390"/>
     <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
    </StackPanel></DataTemplate></ComboBox.ItemTemplate>
   </ComboBox>
  </StackPanel>
  <StackPanel x:Name="NewPanel" Visibility="Collapsed">
   <TextBlock Text="待办标签（桌面待办纸片）" Margin="0,0,0,5"/>
   <ComboBox Style="{DynamicResource AppComboBoxStyle}" x:Name="Paper" DisplayMemberPath="Title" SelectionChanged="SourceChanged"/>
   <TextBlock Text="待办内容" Margin="0,12,0,5"/>
   <TextBox x:Name="NewTitle" MaxLength="240" MinHeight="60" TextWrapping="Wrap" Padding="8" AcceptsReturn="False"/>
  </StackPanel>
  <StackPanel x:Name="DetailsPanel" Visibility="Collapsed">
   <TextBlock x:Name="DetailTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock x:Name="DetailLabel" Margin="0,7,0,0" Foreground="{DynamicResource TextMutedBrush}"/>
  </StackPanel>
  <TextBlock x:Name="ProjectHint" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,12,0,14"/>
  <Grid Margin="0,0,0,14">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="日期" Margin="0,0,0,5"/><DatePicker Style="{DynamicResource AppDatePickerStyle}" x:Name="Day"/></StackPanel>
   <StackPanel Grid.Column="2"><TextBlock Text="时段" Margin="0,0,0,5"/><ComboBox Style="{DynamicResource AppComboBoxStyle}" x:Name="Period" SelectedIndex="0"><ComboBoxItem>上午</ComboBoxItem><ComboBoxItem>下午</ComboBoxItem></ComboBox></StackPanel>
  </Grid>
  <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,12"/>
  <WrapPanel x:Name="DetailActions" Visibility="Collapsed" Margin="0,0,0,12">
   <Button x:Name="ToggleButton" Content="标记完成" Click="Toggle" Padding="12,7" Margin="0,0,8,0"/>
   <Button Content="取消排期" ToolTip="保留原来的待办，只移除日期安排" Click="Remove" Padding="12,7"/>
  </WrapPanel>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="取消" IsCancel="True" Padding="18,8" Margin="0,0,8,0"/>
   <Button Style="{DynamicResource PrimaryButtonStyle}" x:Name="AcceptButton" Content="加入周计划" IsDefault="True" Click="Accept" Padding="18,8"/>
  </StackPanel>
 </StackPanel></ScrollViewer>
 </DockPanel></Border>
</Window>
