<UserControl x:Class="WitchDrawer.App.Views.WeeklyPlanView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{DynamicResource AppFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12">
 <Border Background="{DynamicResource GlassSurfaceBrush}" CornerRadius="{DynamicResource SurfaceCornerRadius}" Padding="12" BorderBrush="{DynamicResource GlassStrokeBrush}" BorderThickness="1">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <WrapPanel x:Name="Heading" Margin="0,0,0,10">
    <TextBlock Text="周计划" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"/>
    <TextBlock Text="为每个半天，留出明确的重点" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
   </WrapPanel>
   <StackPanel Grid.Row="1">
    <DockPanel Margin="0,0,0,8">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
      <Button Margin="0,0,5,0" Content="桌面浮窗" x:Name="DesktopButton" Click="OpenDesktop" ToolTip="把周计划放到桌面"/>
      <Button Margin="0,0,5,0" Content="＋ 添加" Click="AddClick" Style="{DynamicResource PrimaryButtonStyle}"/>
     </StackPanel>
     <WrapPanel VerticalAlignment="Center">
      <Button Margin="0,0,5,0" Content="‹" Click="PreviousWeek" ToolTip="上一周"/>
      <Button Margin="0,0,5,0" Content="本周" Click="CurrentWeek"/>
      <Button Margin="0,0,5,0" Content="›" Click="NextWeek" ToolTip="下一周"/>
      <TextBlock x:Name="WeekLabel" VerticalAlignment="Center" Margin="4,0,0,0" FontWeight="SemiBold"/>
     </WrapPanel>
    </DockPanel>
    <WrapPanel x:Name="Filters" Margin="0,0,0,10">
     <ComboBox Style="{DynamicResource AppComboBoxStyle}" x:Name="StatusFilter" Width="100" SelectedIndex="0" SelectionChanged="FilterChanged" Margin="0,0,8,0" Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource GlassInnerBrush}">
      <ComboBoxItem>全部状态</ComboBoxItem><ComboBoxItem>待完成</ComboBoxItem><ComboBoxItem>已完成</ComboBoxItem>
     </ComboBox>
     <ComboBox Style="{DynamicResource AppComboBoxStyle}" x:Name="ProjectFilter" Width="170" DisplayMemberPath="Name" SelectionChanged="FilterChanged" Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource GlassInnerBrush}"/>
    </WrapPanel>
   </StackPanel>
   <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid x:Name="PlanGrid"/>
   </ScrollViewer>
   <StackPanel Grid.Row="3" Margin="0,9,0,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="Summary" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
     <TextBlock Grid.Column="1" x:Name="ProgressText" Foreground="{DynamicResource PositiveBrush}" FontSize="11"/>
    </Grid>
    <ProgressBar Style="{DynamicResource AppProgressBarStyle}" x:Name="Progress" Height="3" Minimum="0" Maximum="100" Margin="0,6,0,0" Foreground="{DynamicResource PositiveBrush}" Background="{DynamicResource BorderBrushSoft}"/>
    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Margin="0,5,0,0"/>
   </StackPanel>
  </Grid>
 </Border>
</UserControl>
